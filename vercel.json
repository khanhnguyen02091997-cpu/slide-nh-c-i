{
  "outputDirectory": "public",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "functions": {
    "api/chibi.js": {
      "maxDuration": 60
    },
    "api/clone-layout.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/t/:slug",
      "destination": "/api/thiep?s=:slug"
    }
  ]
}
